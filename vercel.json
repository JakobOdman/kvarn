{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite",
      "redirects": [{ "source": "/app", "destination": "/app/", "permanent": true }]
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "api.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
